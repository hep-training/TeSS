<section class="who-are-we-section" style="padding: 60px 0; margin-top:-70px">
  <div class="container">
    <div class="row" style="display: flex; align-items: center;">
      <div class="col-md-8">
        <div class="row">
          <div class="col-sm-6" style="margin-bottom: 30px;">
            <div class="panel" style="border-radius: 12px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); padding: 25px; background-color: #fff; height: 100%; text-align: right;">

              <div style="margin-top: -5px; float:left; margin-right: 15px;">
                <%= image_tag "cern-logo-blue.png", style: "max-width:60px;" %>
              </div>
              <h4 style="margin: 0 0 12px 0; color: #333;">We are from<br>CERN</h4>
              <p style="margin: 0 0 20px 0; color: #666; font-size: 17px;">HEP Training is developed and hosted by CERN, and open to everyone!</p>
              <a href="https://home.cern/" class="btn btn-lg" role="button" style="background-color: #0033A0; color: #fff; border: none; padding: 10px 20px;">CERN Website</a>
            </div>
          </div>

          <div class="col-sm-6" style="margin-bottom: 30px;">
            <div class="panel" style="border-radius: 12px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); padding: 25px; background-color: #fff; height: 100%; text-align: right;">

              <div style="margin-top: -5px; float:left; margin-right: 15px;">
                <%= image_tag "hep-training-small.png", style: "max-width:80px; padding:10px; border-radius:5px; background-color: #051e2f;" %>
              </div>
              <h4 style="margin: 0 0 12px 0; color: #333;">We are a<br>community</h4>
              <p style="margin: 0 0 20px 0; color: #666; font-size: 17px;">Our goal is to engage people in sharing and growing their knowledge.</p>
              <a href="/about/registering" class="btn btn-lg" role="button" style="background-color: #051e2f; color: #fff; border: none; padding: 10px 20px;">Register content</a>
            </div>
          </div>

          <div class="col-sm-6" style="margin-bottom: 30px;">
            <div class="panel" style="border-radius: 12px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); padding: 25px; background-color: #fff; height: 100%; text-align: right;">

              <div style="margin-top: -5px; float:left; margin-right: 15px;">
                <%= image_tag "github.png", style: "max-width:60px;" %>
              </div>
              <h4 style="margin: 0 0 12px 0; color: #333;">We are<br>open-source</h4>
              <p style="margin: 0 0 20px 0; color: #666; font-size: 17px;">HEP Training is based on the TeSS project. Check the repository!</p>
              <a href="https://github.com/ElixirTeSS/TeSS" class="btn btn-lg" role="button" style="background-color: #373639ff; color: #fff; border: none; padding: 10px 20px;">Github repository</a>
            </div>
          </div>

          <div class="col-sm-6" style="margin-bottom: 30px;">
            <div class="panel" style="border-radius: 12px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); padding: 25px; background-color: #fff; height: 100%; text-align: right;">

              <div style="font-size: 38px; color: #a55779ff; margin-top: -5px; float:left; margin-right: 15px;">
                <i class="glyphicon glyphicon-heart-empty"></i>
              </div>
              <h4 style="margin: 0 0 12px 0; color: #333;">We are involved<br>for you</h4>
              <p style="margin: 0 0 20px 0; color: #666; font-size: 17px;">We take care of any feedback to consistently improve the platform.</p>
              <a href="#" class="btn btn-lg" role="button" style="background-color: #a55779ff; color: #fff; border: none; padding: 10px 20px;">Contribute</a>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-4" style="display: flex; flex-direction: column; justify-content: center; padding-left: 40px; text-align:right;">
        <h3 style="margin-top: 0;">Who Are We?</h3>
        <p class="lead">Check our <a href="/about">about page</a></p>
      </div>
    </div>
  </div>
</section>
