<% cache(['home', 'upcoming_events', I18n.locale, session[:tz], @events]) do %>
  <section id="upcoming_events">
    <div class="tab-content">
      <div class="row">
        <div class="col-xs-12 mb-4">
          <h3><%= link_to(t('home.upcoming_events'), events_path, class: 'home-title-link' ) %></h3>
        </div>
      </div>

      <% if TeSS::Config.feature.fetch('timezone_controls') %>
        <%= render partial: 'events/event_timezone_control' %>
      <% end %>

      <%= render partial: 'common/masonry_grid', locals: { objects: @events, ul_class: 'tab-pane fade in active', horizontal: true } %>
    </div>
  </section>
<% end %>
