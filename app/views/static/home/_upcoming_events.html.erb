<% cache(['home', 'upcoming_events', I18n.locale, session[:tz], @events]) do %>
  <section id="upcoming_events">
    <div class="tab-content">
      <div class="row">
        <div class="col-sm-6 mb-4">
          <h3>Upcoming events</h3>
        </div>
        <div class="col-sm-6 text-right">
          <button class="btn mr-2" style="margin-bottom: -50px;"><%= link_to('Add to calendar', '/', class: 'home-title-link' ) %></button>
          <button class="btn ml-2" style="margin-bottom: -50px;"><%= link_to('View all', events_path, class: 'home-title-link' ) %></button>
          <button class="btn ml-2" style="margin-bottom: -50px;"><%= link_to('Register an event', '/events/new', class: 'home-title-link' ) %></button>
        </div>
      </div>

      <% if TeSS::Config.feature.fetch('timezone_controls') %>
        <%= render partial: 'events/event_timezone_control' %>
      <% end %>

      <%= render partial: 'common/masonry_grid', locals: { objects: @events, ul_class: 'tab-pane fade in active', horizontal: true } %>
    </div>
  </section>
<% end %>
