<% cache(['home', 'featured_trainer', @featured_trainer]) do %>
  <section id="featured_trainer">
    <div class="tab-content">
      <div class="row">
        <div class="col-xs-12 mb-4">
          <h3><%= link_to('Featured trainer', trainers_path, class: 'home-title-link' ) %></h3>
        </div>
      </div>
      <%= render partial: 'common/masonry_grid', locals: { objects: [@featured_trainer], ul_class: 'tab-pane fade in active', horizontal: true } %>
    </div>
  </section>
<% end %>
