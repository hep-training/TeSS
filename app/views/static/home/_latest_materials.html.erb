<% cache(['home', 'latest_materials', @materials]) do %>
  <section id="latest_materials">
    <div class="tab-content">
      <div class="row">
        <div class="col-xs-12 mb-4">
          <h3><%= link_to('Latest materials', materials_path, class: 'home-title-link' ) %></h3>
        </div>
      </div>
      <%= render partial: 'common/masonry_grid', locals: { objects: @materials, ul_class: 'fade in active', horizontal: true } %>
    </div>
  </section>
<% end %>
