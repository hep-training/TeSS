<% cache(['home', 'latest_materials', @materials]) do %>
  <section id="latest_materials">
    <div class="tab-content">
      <div class="row">
        <div class="col-sm-6 mb-4">
          <h3>Latest materials</h3>
        </div>
        <div class="col-sm-6 text-right">
          <button class="btn mr-2" style="margin-bottom: -50px;"><%= link_to('View all', materials_path, class: 'home-title-link' ) %></button>
          <button class="btn ml-2" style="margin-bottom: -50px;"><%= link_to('Register a material', '/materials/new', class: 'home-title-link' ) %></button>
        </div>
      </div>
      <%= render partial: 'common/masonry_grid', locals: { objects: @materials, ul_class: 'fade in active', horizontal: true } %>
    </div>
  </section>
<% end %>
