<section class="who-are-you-section" style="padding: 60px 0;">
  <div class="container">
    <div class="row text-center" style="margin-bottom: 40px;">
      <h2>Who Are You?</h2>
      <p class="lead">Choose your path</p>
    </div>
    
    <div class="row">
      <!-- Newcomer Card -->
      <div class="col-md-3 col-sm-6 visitor-card" style="margin-bottom: 20px;">
        <div class="panel panel" style="height: 100%; display: flex; flex-direction: column;">
          <div class="panel-heading text-center" style="padding: 20px; background-color: #2a62a7ff;">
            <div style="font-size: 56px; color: #fff; margin-bottom: 10px;">
              <i class="glyphicon glyphicon-star"></i>
            </div>
            <h3 style="margin: 0; color: #fff;">I'm New Here</h3>
          </div>
          <div class="panel-body text-center" style="padding: 30px; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between;">
            <p>Welcome! If you don't know where to start, click on the button below.</p>
            <a href="/about" class="btn btn-lg" role="button" style="margin-top: 20px; background-color: #2a62a7ff; color: #fff;">Get Started</a>
          </div>
        </div>
      </div>

      <!-- Trainer Card -->
      <div class="col-md-3 col-sm-6 visitor-card" style="margin-bottom: 20px;">
        <div class="panel" style="height: 100%; display: flex; flex-direction: column;">
          <div class="panel-heading text-center" style="padding: 20px; background-color: #2e5b33ff;">
            <div style="font-size: 56px; color: #fff; margin-bottom: 10px;">
              <i class="glyphicon glyphicon-blackboard"></i>
            </div>
            <h3 style="margin: 0; color: #fff;">I'm a Trainer</h3>
          </div>
          <div class="panel-body text-center" style="padding: 30px; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between;">
            <p>Share your expertise! Create and deliver engaging courses.</p>
            <a href="/about/registering" class="btn btn-lg" role="button" style="margin-top: 20px; background-color: #2e5b33ff; color: #fff;">Register content</a>
          </div>
        </div>
      </div>

      <!-- Group Member Card -->
      <div class="col-md-3 col-sm-6 visitor-card">
        <div class="panel" style="height: 100%; display: flex; flex-direction: column;">
          <div class="panel-heading text-center" style="padding: 20px; background-color: #aa6328ff;">
            <div style="font-size: 56px; color: #fff; margin-bottom: 10px;">
              <i class="glyphicon glyphicon-flag"></i>
            </div>
            <h3 style="margin: 0; color: #fff;">I'm in a Group</h3>
          </div>
          <div class="panel-body text-center" style="padding: 30px; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between;">
            <p>Already part of our community? Access your group now!</p>
            <a href="#" class="btn btn-lg" role="button" style="margin-top: 20px; background-color: #aa6328ff; color: #fff;">Find my group</a>
          </div>
        </div>
      </div>

      <!-- Content Provider Card -->
      <div class="col-md-3 col-sm-6 visitor-card">
        <div class="panel" style="height: 100%; display: flex; flex-direction: column;">
          <div class="panel-heading text-center" style="padding: 20px; background-color: #9b345dff;">
            <div style="font-size: 56px; color: #fff; margin-bottom: 10px;">
              <i class="glyphicon glyphicon-home"></i>
            </div>
            <h3 style="margin: 0; color: #fff;">I'm a Collective</h3>
          </div>
          <div class="panel-body text-center" style="padding: 30px; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between;">
            <p>You can easely register yourself as a content provider at no cost to share your ressources.</p>
            <a href="#" class="btn btn-lg" role="button" style="margin-top: 20px; background-color: #9b345dff; color: #fff;">Contribute</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
