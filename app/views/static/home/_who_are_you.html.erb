<section class="who-are-we-section" style="padding: 60px 0;">
  <div class="container">
    <div class="row" style="display: flex; align-items: center;">
      <!-- Left Column: Title & Subtitle -->
      <div class="col-md-4" style="display: flex; flex-direction: column; justify-content: center; padding-right: 40px;">
        <h3 style="margin-top: 0;">Who Are You?</h3>
        <p class="lead">Find your path</p>
      </div>

      <!-- Right Column: 2x2 Grid Cards -->
      <div class="col-md-8">
        <div class="row">
          <!-- Newcomer Card -->
          <div class="col-sm-6" style="margin-bottom: 30px;">
            <div class="panel" style="border-radius: 12px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); padding: 25px; background-color: #fff; height: 100%;">
              <div style="font-size: 38px; color: #497dbbff; margin-top: -5px; float:right;">
                <i class="glyphicon glyphicon-star"></i>
              </div>
              <h4 style="margin: 0 0 12px 0; color: #333;">I'm New Here</h4>
              <p style="margin: 0 0 20px 0; color: #666; font-size: 17px; padding-right:45px;">Welcome! If you don't know where to start, click on the button below.</p>
              <a href="/about" class="btn btn-lg" role="button" style="background-color: #497dbbff; color: #fff; border: none; padding: 10px 20px;">Get Started</a>
            </div>
          </div>

          <!-- Trainer Card -->
          <div class="col-sm-6" style="margin-bottom: 30px;">
            <div class="panel" style="border-radius: 12px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); padding: 25px; background-color: #fff; height: 100%;">
              <div style="font-size: 38px; color: #466d4bff; margin-top: -5px; float:right;">
                <i class="glyphicon glyphicon-blackboard"></i>
              </div>
              <h4 style="margin: 0 0 12px 0; color: #333;">I'm a Trainer</h4>
              <p style="margin: 0 0 20px 0; color: #666; font-size: 17px; padding-right:45px;">Share your expertise! Create and deliver engaging courses.</p>
              <a href="/about/registering" class="btn btn-lg" role="button" style="background-color: #466d4bff; color: #fff; border: none; padding: 10px 20px;">Register content</a>
            </div>
          </div>

          <!-- Group Member Card -->
          <div class="col-sm-6" style="margin-bottom: 30px;">
            <div class="panel" style="border-radius: 12px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); padding: 25px; background-color: #fff; height: 100%;">
              <div style="font-size: 38px; color: #a7642eff; margin-top: -5px; float:right;">
                <i class="glyphicon glyphicon-flag"></i>
              </div>
              <h4 style="margin: 0 0 12px 0; color: #333;">I'm in a Group</h4>
              <p style="margin: 0 0 20px 0; color: #666; font-size: 17px; padding-right:45px;">Already part of our community? Access your group now!</p>
              <a href="#" class="btn btn-lg" role="button" style="background-color: #a7642eff; color: #fff; border: none; padding: 10px 20px;">Find my group</a>
            </div>
          </div>

          <!-- Content Provider Card -->
          <div class="col-sm-6" style="margin-bottom: 30px;">
            <div class="panel" style="border-radius: 12px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); padding: 25px; background-color: #fff; height: 100%;">
              <div style="font-size: 38px; color: #784c8aff; margin-top: -5px; float:right;">
                <i class="glyphicon glyphicon-home"></i>
              </div>
              <h4 style="margin: 0 0 12px 0; color: #333;">I'm a Collective</h4>
              <p style="margin: 0 0 20px 0; color: #666; font-size: 17px; padding-right:45px;">Register yourself as a provider for free to share your resources!</p>
              <a href="#" class="btn btn-lg" role="button" style="background-color: #784c8aff; color: #fff; border: none; padding: 10px 20px;">Contribute</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
