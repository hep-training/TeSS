<section class="who-are-you-section">
  <div class="container">

    <!-- Title Row -->
    <div class="row">
      <div class="col-xs-12 mb-4">
        <h3><%= t('home.who_are_you.heading') %></h3>
      </div>
    </div>

    <!-- Cards Row -->
    <div class="row">

      <!-- Newcomer Card -->
      <div class="col-sm-6 col-md-6 m-b-30">
        <a href="/about" class="pathway-link">
          <div class="panel panel-default pathway-card p-2 card-newcomer">
            <div class="panel-body">
              <div class="card-icon">
                <i class="glyphicon glyphicon-star"></i>
              </div>
              <h4 class="card-title mb-5"><%= t('home.who_are_you.newcomer.title') %></h4>
              <p class="card-text"><%= t('home.who_are_you.newcomer.text') %></p>
            </div>
          </div>
        </a>
      </div>

      <!-- Trainer Card -->
      <div class="col-sm-6 col-md-6 m-b-30">
        <a href="/about/registering" class="pathway-link">
          <div class="panel panel-default pathway-card p-2 card-trainer">
            <div class="panel-body">
              <div class="card-icon">
                <i class="glyphicon glyphicon-blackboard"></i>
              </div>
              <h4 class="card-title mb-5"><%= t('home.who_are_you.trainer.title') %></h4>
              <p class="card-text"><%= t('home.who_are_you.trainer.text') %></p>
            </div>
          </div>
        </a>
      </div>

      <!-- Group Member Card -->
      <div class="col-sm-6 col-md-6 m-b-30">
        <a href="#" class="pathway-link">
          <div class="panel panel-default pathway-card p-2 card-group">
            <div class="panel-body">
              <div class="card-icon">
                <i class="glyphicon glyphicon-flag"></i>
              </div>
              <h4 class="card-title mb-5"><%= t('home.who_are_you.group.title') %></h4>
              <p class="card-text"><%= t('home.who_are_you.group.text') %></p>
            </div>
          </div>
        </a>
      </div>

      <!-- Content Provider Card -->
      <div class="col-sm-6 col-md-6 m-b-30">
        <a href="/about/content_providers" class="pathway-link">
          <div class="panel panel-default pathway-card p-2 card-collective">
            <div class="panel-body">
              <div class="card-icon">
                <i class="glyphicon glyphicon-home"></i>
              </div>
              <h4 class="card-title mb-5"><%= t('home.who_are_you.collective.title') %></h4>
              <p class="card-text"><%= t('home.who_are_you.collective.text') %></p>
            </div>
          </div>
        </a>
      </div>

    </div>

  </div>
</section>
