<% horizontal ||= false %>
<% ul_class ||= nil %>

<% if objects.present? && objects.count > 0 %>
  <% base_class = horizontal ? 'masonry-horizontal' : 'masonry media-grid' %>
  <% classes = [base_class, ul_class].compact.join(' ') %>
  <ul class="<%= classes %>">
    <% objects.each do |object| %>
      <%= render object, horizontal: horizontal %>
    <% end %>
  </ul>
<% end %>

