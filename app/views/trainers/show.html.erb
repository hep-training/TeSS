<div class="wrapper collapsing-wrapper-tb">

  <div class="collapsing-sidebar" id="sidebar">
    <div id="gravatar_image">
      <%= image_tag @trainer.user.avatar_url, class: 'medium-trainer-logo hidden-lg hidden-md' %>
      <%= image_tag @trainer.user.avatar_url, class: 'large-trainer-logo hidden-sm hidden-xs' %>
    </div>
  </div>
  <div id="content">
    <!-- Field: full name -->
    <h2>
      <%= @trainer.full_name %>
    </h2>
    <!-- Field: website -->
    <% if @trainer.website.present? %>
      <div class="url-wrap">
        <%= external_link @trainer.website, @trainer.website, class: 'h5', target: '_blank', rel: 'noopener', track: true %>
      </div>
    <% end %>

    <!-- Field: orcid -->
    <% if @trainer.orcid.present? %>
      <div class="url-wrap">
        <%= orcid_link(@trainer, class: 'h5', track: true) %>
      </div>
    <% end %>

    <!-- Field:  description -->
    <% if @trainer.description.present? %>
      <div class="description">
        <%= render_markdown @trainer.description %>
      </div>
    <% end %>

    <!-- Field: other fields -->
    <div style="margin-bottom: 60px;">
      <!-- SKILLS -->
      <% if @trainer.expertise_academic.present? || @trainer.expertise_technical.present? || @trainer.fields.present? || @trainer.experience.present? %>
        <div class="row">
          <%= render partial: 'common/box_info',
            locals: {
              title: 'Skills',
              title_color: '#222',
              bg_color: '#d4e5f4ff',
              glyphicon: 'education',
              infos: {
                ('Experience' if @trainer.experience.present?) => @trainer.experience,
                ('Academic expertise' if @trainer.expertise_academic.any?) => @trainer.expertise_academic.join(', '),
                ('Technical expertise' if @trainer.expertise_technical.any?) => @trainer.expertise_technical.join(', '),
                ('Fields' if @trainer.fields.any?) => @trainer.fields.join(', ')
              }.compact
            }
          %>
        </div>
      <% end %>

      <div class="row">
        <!-- CONTACT -->
        <% if @trainer.email.present? || @trainer.location.present? || @trainer.social_media.present? || @trainer.language.present? %>
          <div class="col-md-6 col-sm-12">
            <%= render partial: 'common/box_info',
              locals: {
                title: 'Contact',
                title_color: '#222',
                bg_color: '#f1dec9ff',
                glyphicon: 'envelope',
                infos: {
                  ('Email' if @trainer.email.present?) => @trainer.email,
                  ('Location' if @trainer.location.present?) => @trainer.location,
                  ('Language' if @trainer.language.any?) => @trainer.language.join(', '),
                  ('Social media' if @trainer.social_media.any?) => @trainer.social_media.join(', ')
                }.compact
              }
            %>
          </div>
        <% end %>

        <!-- OTHERS -->
        <% if @trainer.interest.present? || @trainer.activity.present? %>
          <div class="col-md-6 col-sm-12">
            <%= render partial: 'common/box_info',
              locals: {
                title: 'Others',
                title_color: '#222',
                bg_color: '#e6f4ea',
                glyphicon: 'info-sign',
                infos: {
                  ('Interest' if @trainer.interest.any?) => @trainer.interest.join(', '),
                  ('Activity' if @trainer.activity.any?) => @trainer.activity.join(', ')
                }.compact
              }
            %>
          </div>
        <% end %>
        
      </div>

      <!-- Other metadata -->
      <%= render partial: 'trainers/partials/twitter_card', locals: { trainer: @trainer } %>
    </div>

    <!-- Field: registrations list with Events, Materials, Collections, Workflows -->
    <%= render(partial: 'common/registrations_list', locals: { user: @trainer.user }) %>
  </div>
</div>
